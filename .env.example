# Скопируйте в .env и при необходимости поправьте.
# Значения по умолчанию уже указывают на прод.

MAKEUP_BASE_URL=http://90.188.89.63:8085
CHAT_BASE_URL=http://90.188.89.63:8086

# SSH-туннель к node_exporter на прод-сервере (серверные метрики CPU/RAM/диск/сеть).
SSH_TARGET=dmitry_buldakov@90.188.89.63
SSH_PORT=2222
SSH_KEY=~/.ssh/id_ed25519

# Необязательно: логин существующим пользователем вместо регистрации тестового.
CHAT_USERNAME=
CHAT_PASSWORD=

# --- Email-алерты (Alertmanager) ---
# SMTP для уведомлений о недоступности бэкендов/сервера.
# Gmail: включите 2FA и создайте App Password (обычный пароль не подойдёт).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com