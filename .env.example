# Скопируйте в .env и поправьте под свои адреса.

# --- Что нагружаем ---
MAKEUP_BASE_URL=http://168.222.194.206:8085
CHAT_BASE_URL=http://168.222.194.206:8086

# Бэкенд wcm закрыт снаружи (в его compose 127.0.0.1:8087:8080), наружу
# торчит только фронт на 80/443. На akm-сервере 127.0.0.1:8087 — это
# обратный SSH-туннель k6-wcm-tunnel с машины мониторинга.
WCM_BASE_URL=http://127.0.0.1:8087

# Заголовок, который требует FrontendAccessFilter на /api/wcm/*.
# Без него бэкенд отвечает 403 и сценарий ничего не нагружает.
# Должно совпадать с FRONTEND_CLIENT_KEY в .env бэкенда wcm.
WCM_CLIENT_KEY=wcm-frontend

# --- Куда сливать метрики прогона ---
# Адрес Prometheus из репозитория monitoring. Должен быть доступен с машины,
# с которой идёт прогон. Если недоступен — прогон всё равно отработает,
# но в Grafana метрики не попадут.
K6_PROMETHEUS_RW_SERVER_URL=http://127.0.0.1:9090/api/v1/write

# Необязательно: логин существующим пользователем вместо регистрации тестового.
CHAT_USERNAME=
CHAT_PASSWORD=

# --- Параметры прогона ---
# TESTID — метка прогона, по ней фильтруешь дашборд "k6 Prometheus" в Grafana.
# По умолчанию берётся дата-время запуска.
# TESTID=my-run
# LOAD_PEAK_RPS=100        пиковый RPS (иначе — аргумент команды)
# LOAD_RAMP=1m LOAD_HOLD=2m LOAD_DOWN=30s
# PREALLOC_FACTOR=0.15     доля RPS на preAllocatedVUs
